pipeline {
  agent any
  stages {
    stage('checkout') {
      steps {
        echo 'hello world'
      }
    }

    stage('test') {
      steps {
        echo 'test succes'
      }
    }

    stage('build') {
      steps {
        echo 'build succes'
      }
    }

    stage('deploy') {
      steps {
        echo 'deploy succes'
      }
    }

  }
}